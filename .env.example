# Sidecar services read these from the process environment (systemd
# Environment=), not from this file. They are not in credentials.ALLOWED_KEYS,
# so putting them above as real keys would make load_env_file reject the file.
# MEME_RADAR_SOL_EARLY_TELEGRAM_ENABLED=0
# MEME_RADAR_SOL_EARLY_POLL_SECONDS=2
# MEME_RADAR_SOL_EARLY_PROVIDER_CALLS_PER_HOUR=24
# MEME_RADAR_PONS_CURVE_TELEGRAM_ENABLED=0
# MEME_RADAR_PONS_CURVE_MAX_PER_HOUR=2
# MEME_RADAR_PONS_CURVE_POLL_SECONDS=10
# 后验采集 sidecar（meme-radar-outcome-collector）：只读上游决策，写入
# outcome_cohort/outcomes，不发送任何消息。CONTROL_SAMPLE_RATE 是未评估层的
# 抽样比例，取值 (0, 1]，用来控制对照层规模而不是放宽任何策略门。
# MEME_RADAR_OUTCOME_POLL_SECONDS=20
# MEME_RADAR_OUTCOME_ENROLL_LOOKBACK_SECONDS=180
# MEME_RADAR_OUTCOME_ENROLL_PER_CYCLE=25
# MEME_RADAR_OUTCOME_MEASURE_PER_CYCLE=25
# MEME_RADAR_OUTCOME_CONTROL_SAMPLE_RATE=0.001
# MEME_RADAR_OUTCOME_CONTROL_PER_CYCLE=2
# MEME_RADAR_OUTCOME_PROVIDER_CALLS_PER_HOUR=240
