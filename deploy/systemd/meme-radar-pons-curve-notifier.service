[Unit]
Description=Meme Radar Robinhood Pons curve gated notifier
After=network-online.target meme-radar.service meme-radar-pons-curve-shadow.service
Wants=network-online.target
Requires=meme-radar-pons-curve-shadow.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=memeradar
Group=memeradar
WorkingDirectory=/opt/meme-radar/current
EnvironmentFile=/etc/meme-radar/telegram.env
Environment=PYTHONPATH=/opt/meme-radar/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MEME_RADAR_PONS_CURVE_TELEGRAM_ENABLED=1
Environment=MEME_RADAR_PONS_CURVE_MAX_PER_HOUR=2
Environment=MEME_RADAR_PONS_CURVE_POLL_SECONDS=10
ExecStart=/opt/meme-radar/venv/bin/python -m meme_radar.pons_curve_notifier --env-file /etc/meme-radar/telegram.env --rpc-env /etc/meme-radar/pons-curve-rpc.env --shadow-db /var/lib/meme-radar/pons-curve-shadow/shadow.db --shadow-health /var/lib/meme-radar/pons-curve-shadow/health.json --main-db /var/lib/meme-radar/radar.db --db-path /var/lib/meme-radar/pons-curve-notifier/notifier.db --health-path /var/lib/meme-radar/pons-curve-notifier/health.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/opt/meme-radar
ReadOnlyPaths=/etc/meme-radar
ReadOnlyPaths=/var/lib/meme-radar/radar.db
ReadOnlyPaths=-/var/lib/meme-radar/radar.db-wal
ReadOnlyPaths=-/var/lib/meme-radar/radar.db-shm
ReadOnlyPaths=/var/lib/meme-radar/pons-curve-shadow
ReadWritePaths=/var/lib/meme-radar/pons-curve-notifier

MemoryAccounting=true
MemoryHigh=128M
MemoryMax=192M
MemorySwapMax=0
TasksMax=24
LimitNOFILE=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=meme-radar-pons-curve-notifier

[Install]
WantedBy=multi-user.target
