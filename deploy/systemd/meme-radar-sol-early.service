[Unit]
Description=Meme Radar Solana early-information notifier
After=network-online.target meme-agent-gmgnsignals-fast-listener.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=memeradar
Group=memeradar
SupplementaryGroups=meme-agent-raw
WorkingDirectory=/opt/meme-radar-sol-early/current
EnvironmentFile=/etc/meme-radar/sol-early-telegram.env
Environment=PYTHONPATH=/opt/meme-radar-sol-early/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MEME_RADAR_SOL_EARLY_TELEGRAM_ENABLED=1
Environment=MEME_RADAR_SOL_EARLY_POLL_SECONDS=2
Environment=MEME_RADAR_SOL_EARLY_PROVIDER_CALLS_PER_HOUR=24
ExecStart=/opt/meme-radar/venv/bin/python -m meme_radar.sol_early_notifier --telegram-env /etc/meme-radar/sol-early-telegram.env --raw /var/lib/meme-agent/migration-v1/raw/gmgnsignals_fast_events.jsonl --db-path /var/lib/meme-radar-sol-early/notifier.db --health-path /var/lib/meme-radar-sol-early/health.json --policy /opt/meme-radar-sol-early/current/config/sol_early_v1.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
StateDirectory=meme-radar-sol-early
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/opt/meme-radar
ReadOnlyPaths=/opt/meme-radar-sol-early
ReadOnlyPaths=/etc/meme-radar/sol-early-telegram.env
ReadOnlyPaths=/var/lib/meme-agent/migration-v1/raw
ReadWritePaths=/var/lib/meme-radar-sol-early

MemoryAccounting=true
MemoryHigh=128M
MemoryMax=192M
MemorySwapMax=0
TasksMax=24
LimitNOFILE=4096

StandardOutput=journal
StandardError=journal
SyslogIdentifier=meme-radar-sol-early

[Install]
WantedBy=multi-user.target
