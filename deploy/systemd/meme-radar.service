[Unit]
Description=Meme Radar multi-chain collector and gated notifier
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=memeradar
Group=memeradar
WorkingDirectory=/opt/meme-radar/current
EnvironmentFile=/etc/meme-radar/radar.env
Environment=PYTHONPATH=/opt/meme-radar/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MEME_RADAR_DB_PATH=/var/lib/meme-radar/radar.db
Environment=MEME_RADAR_HEALTH_PATH=/var/lib/meme-radar/health.json
Environment=MEME_RADAR_FOMO_POLL_SECONDS=300
Environment=MEME_RADAR_CLANKER_POLL_SECONDS=60
Environment=MEME_RADAR_ENRICH_MAX_PER_HOUR=300
Environment=MEME_RADAR_BACKFILL_MAX_MINUTES=10
ExecStart=/opt/meme-radar/venv/bin/python -m meme_radar.daemon --env-file /etc/meme-radar/radar.env --db-path /var/lib/meme-radar/radar.db --health-path /var/lib/meme-radar/health.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/opt/meme-radar
ReadOnlyPaths=/etc/meme-radar
ReadWritePaths=/var/lib/meme-radar

MemoryAccounting=true
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
TasksMax=64
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=meme-radar

[Install]
WantedBy=multi-user.target
