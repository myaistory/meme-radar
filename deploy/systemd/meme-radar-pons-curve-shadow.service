[Unit]
Description=Meme Radar Robinhood Pons curve shadow collector
After=network-online.target meme-radar.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=memeradar
Group=memeradar
WorkingDirectory=/opt/meme-radar/current
EnvironmentFile=/etc/meme-radar/native-rpc.env
Environment=PYTHONPATH=/opt/meme-radar/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/meme-radar/venv/bin/python -m meme_radar.pons_curve_shadow --env-file /etc/meme-radar/native-rpc.env --source-db /var/lib/meme-radar/radar.db --db-path /var/lib/meme-radar/pons-curve-shadow/shadow.db --health-path /var/lib/meme-radar/pons-curve-shadow/health.json --backfill-blocks 100
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/opt/meme-radar
ReadOnlyPaths=/etc/meme-radar
ReadOnlyPaths=/var/lib/meme-radar/radar.db
ReadOnlyPaths=-/var/lib/meme-radar/radar.db-wal
ReadOnlyPaths=-/var/lib/meme-radar/radar.db-shm
ReadWritePaths=/var/lib/meme-radar/pons-curve-shadow

MemoryAccounting=true
MemoryHigh=320M
MemoryMax=384M
MemorySwapMax=0
TasksMax=32
LimitNOFILE=8192

StandardOutput=journal
StandardError=journal
SyslogIdentifier=meme-radar-pons-curve-shadow

[Install]
WantedBy=multi-user.target
