[Unit]
# Post-hoc outcome collector. Reads decisions the main radar already made and
# measures what happened to them. It never writes radar_events, decisions or
# telegram_outbox, and has no Telegram credentials at all.
Description=Meme Radar post-hoc outcome collector
After=network-online.target meme-radar.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=memeradar
Group=memeradar
WorkingDirectory=/opt/meme-radar/current
Environment=PYTHONPATH=/opt/meme-radar/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MEME_RADAR_OUTCOME_POLL_SECONDS=20
Environment=MEME_RADAR_OUTCOME_ENROLL_LOOKBACK_SECONDS=180
Environment=MEME_RADAR_OUTCOME_ENROLL_PER_CYCLE=25
Environment=MEME_RADAR_OUTCOME_MEASURE_PER_CYCLE=25
Environment=MEME_RADAR_OUTCOME_CONTROL_SAMPLE_RATE=0.001
Environment=MEME_RADAR_OUTCOME_CONTROL_PER_CYCLE=2
Environment=MEME_RADAR_OUTCOME_PROVIDER_CALLS_PER_HOUR=240
ExecStart=/opt/meme-radar/venv/bin/python -m meme_radar.outcome_collector --db-path /var/lib/meme-radar/radar.db --health-path /var/lib/meme-radar/outcome-collector/health.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
StateDirectory=meme-radar/outcome-collector
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths=/opt/meme-radar
ReadWritePaths=/var/lib/meme-radar

MemoryAccounting=true
MemoryHigh=128M
MemoryMax=192M
MemorySwapMax=0
TasksMax=16
LimitNOFILE=2048

StandardOutput=journal
StandardError=journal
SyslogIdentifier=meme-radar-outcome-collector

[Install]
WantedBy=multi-user.target
